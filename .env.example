# Mattermost instance URL
MM_URL=https://mattermost.example.com

# Personal access token (from Account Settings → Security → Personal Access Tokens)
MM_TOKEN=your-personal-access-token

# Name (URL slug) of the team to list channels from, e.g. `my-team` in https://mattermost.example.com/my-team/channels/...
# Used by export_channels_list.py, and by export.py --channels-file to resolve the listed channels
MM_TEAM_NAME="your-team-name"

# ID of the channel(s) to export. Comma-separated for multiple channels, e.g. `abc123,def456`
# Not needed when running export.py --channels-file
MM_CHANNEL_ID="abc123def456"

# Cookie header to send with every request, needed when the instance sits behind an auth proxy
# Optional: only needed behind an oauth2-proxy. See README ("Cookie-based authentication") for how to get it:
# log in to Mattermost in your browser, then copy the `_oauth2_proxy` cookie value from its dev tools
MM_COOKIE="_oauth2_proxy=XXXX"

# Directory where the output files are written (overridden by export.py -o)
MM_OUTPUT_DIR="exports"

# Download shared images (image/* files) next to the JSON export
# Optional: defaults to true. Set to "false" to skip downloading images.
MM_DOWNLOAD_IMAGES="true"
